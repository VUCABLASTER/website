name: Website bauen

# Baut Archiv, Folgenseiten und Kurzlinks aus dem Feed von podcaster.de neu und committet das Ergebnis nach docs/.
# GitHub Pages veröffentlicht danach wie gewohnt aus main /docs.
# Vorerst nur per Knopfdruck (Actions → „Website bauen“ → Run workflow).
# Nach dem WORCamp 2026 aktivieren: die beiden auskommentierten Auslöser unten einkommentieren.
on:
  workflow_dispatch:
  # schedule:
  #   - cron: '17 4 * * *'      # täglich 06:17 Uhr (Sommerzeit)
  # push:
  #   branches: [main]
  #   paths: ['inhalte/**']     # nach Änderungen über Pages CMS

permissions:
  contents: write

concurrency:
  group: website-bauen
  cancel-in-progress: false

jobs:
  bauen:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - run: pip install pillow
      - run: python werkzeuge/build.py
      - name: Änderungen committen
        run: |
          git config user.name "VUCA Blaster Bot"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add -A docs inhalte daten
          if git diff --cached --quiet; then
            echo "Keine Änderungen."
          else
            git commit -m "Website automatisch aktualisiert"
            git push
          fi
